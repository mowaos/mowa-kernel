{
  "name": "@mowaos/kernel",
  "version": "0.5.2",
  "type": "module",
  "description": "MO·WA OS kernel as one npm package: the same WASM binary for Node and browsers, with no build tools needed",
  "author": "Bruce Gardiner (ScrAtcH)",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./mowa_wasm_bg.wasm": "./wasm/mowa_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/copy-wasm.mjs && tsc",
    "pretest": "npm run build",
    "test": "node --test tests/kernel.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mowaos/mowa-kernel.git",
    "directory": "packages/kernel"
  },
  "keywords": [
    "mowa",
    "fsm",
    "workflow",
    "deterministic",
    "audit",
    "replay",
    "wasm"
  ],
  "engines": {
    "node": ">=20"
  }
}
