          },
          "facts": {
            "facts": {
              "check:screening": "HIT"
            }
          },
          "expect": {
            "status": "KERNEL_ERROR",
            "code": "GUARD_NOT_SATISFIED",
            "error": {
              "state": "submitted",
              "key": "finalise"
            }
          }
        }
      ]
    },
    {
      "name": "a fact the guard reads is missing",
