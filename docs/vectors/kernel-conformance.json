{
  "description": "Kernel conformance cases. Each case runs its steps in order against `flow` (with any `flowPatch` applied as a JSON merge patch, RFC 7386). An advance step uses the session from the case's last successful start or advance. Steps omit fields that equal `eventDefaults` and `ctxDefaults`; the event fields given replace the defaults one by one. For every OK step the runner also recomputes all hashes independently (hashing-spec.md). See docs/kernel-spec.md.",
  "flow": {
    "id": "example.review",
    "version": "1",
    "status": "ACTIVE",
    "startNode": "submitted",
    "startActors": [
      "SYSTEM"
    ],
    "description": "Conformance flow: screening, document checks, fallbacks and terminal states.",
    "declaredFacts": {
      "check:screening": [
        "PASS",
        "HIT"
      ],
      "doc:invoice": [
        "VERIFIED",
        "MISSING",
        "CONFLICTED"
      ],
      "doc:packing": [
        "VERIFIED",
        "MISSING",
        "CONFLICTED"
      ]
    },
    "nodes": {
      "submitted": {
        "id": "submitted",
        "type": "intake",
        "tier": "T1",
        "transitions": {
          "approve": {
            "to": "approved",
            "allowedActors": [
              "REVIEWER"
            ],
            "guard": {
              "op": "status_is",
              "target": "check:screening",
              "status": "PASS"
            },
            "onGuardFail": "held"
          },
          "finalise": {
            "to": "approved",
            "allowedActors": [
              "REVIEWER"
            ],
            "guard": {
              "op": "status_is",
              "target": "check:screening",
              "status": "PASS"
            }
          },
          "docs_check": {
            "to": "ready",
            "allowedActors": [
              "SYSTEM"
            ],
            "guard": {
              "op": "all_of",
              "guards": [
                {
                  "op": "none_with_status",
                  "prefix": "doc:",
                  "status": "CONFLICTED"
                },
                {
                  "op": "any_of",
                  "guards": [
                    {
                      "op": "status_is",
                      "target": "doc:invoice",
                      "status": "VERIFIED"
                    },
                    {
                      "op": "not",
                      "guard": {
                        "op": "status_is",
                        "target": "doc:packing",
                        "status": "MISSING"
                      }
                    }
                  ]
                }
              ]
            },
            "onGuardFail": "held"
          },
          "withdraw": {
            "to": "withdrawn",
            "allowedActors": [
              "SYSTEM",
              "REVIEWER"
            ]
          }
        }
      },
      "held": {
        "id": "held",
        "type": "review",
        "tier": "T2",
        "transitions": {
          "release": {
            "to": "submitted",
            "allowedActors": [
              "REVIEWER"
            ]
          }
        }
      },
      "ready": {
        "id": "ready",
        "type": "queue",
        "tier": "T1",
        "transitions": {
          "close": {
            "to": "approved",
            "allowedActors": [
              "SYSTEM"
            ]
          }
        }
      },
      "approved": {
        "id": "approved",
        "type": "outcome",
        "tier": "T0",
        "terminal": true,
        "onEnter": [
          {
            "kind": "notify",
            "payload": {
              "template": "approved"
            }
          },
          {
            "kind": "archive"
          }
        ]
      },
      "withdrawn": {
        "id": "withdrawn",
        "type": "outcome",
        "tier": "T0",
        "terminal": true
      }
    },
    "effectiveFrom": 1000,
    "effectiveTo": 100000
  },
  "eventDefaults": {
    "id": "evt-1",
    "type": "SUBMITTED",
    "source": "conformance",
    "caseId": "case-1",
    "timestamp": 1000,
    "idempotencyKey": "k-1",
    "actor": {
      "type": "SYSTEM",
      "id": "system-1"
    },
    "payload": {}
  },
  "ctxDefaults": {
    "asOf": 2000,
    "contextRefs": {
      "screeningList": "2026-11-01"
    }
  },
  "cases": [
    {
      "name": "start creates version 0 on the start node",
      "spec": "kernel-spec.md#3-start",
      "steps": [
        {
          "call": "start",
          "sessionId": "S1",
          "expect": {
            "status": "OK",
            "state": "submitted",
            "version": 0,
            "fromState": null,
            "outbox": []
          }
        }
      ]
    },
    {
      "name": "guard true: transition taken, onEnter effects emitted in order",
      "spec": "kernel-spec.md#4-advance",
      "steps": [
        {
          "call": "start",
          "sessionId": "S1",
          "expect": {
            "status": "OK",
            "state": "submitted",
            "version": 0
          }
        },
        {
          "call": "advance",
          "event": {
            "type": "approve",
            "actor": {
              "type": "REVIEWER",
              "id": "reviewer-1"
            }
          },
          "facts": {
            "facts": {
              "check:screening": "PASS"
            }
          },
          "expect": {
            "status": "OK",
            "state": "approved",
            "version": 1,
            "fromState": "submitted",
            "guardFailed": false,
            "outbox": [
              "notify",
              "archive"
            ]
          }
        }
      ]
    },
    {
      "name": "guard false with onGuardFail: fallback taken, guardFailed true",
      "spec": "kernel-spec.md#4-advance",
      "steps": [
        {
          "call": "start",
          "sessionId": "S1",
          "expect": {
            "status": "OK",
            "state": "submitted",
            "version": 0
