        {
          "call": "advance",
          "event": {
            "type": "approve",
            "actor": {
              "type": "REVIEWER",
              "id": "reviewer-1"
            }
          },
          "facts": {
            "facts": {
              "check:screening": "HIT"
            }
          },
          "expect": {
            "status": "OK",
            "state": "held",
            "version": 1,
            "guardFailed": true,
            "outbox": []
          }
        }
      ]
    },
    {
      "name": "guard false without onGuardFail is an error",
      "spec": "kernel-spec.md#4-advance",
      "steps": [
        {
          "call": "start",
          "sessionId": "S1",
          "expect": {
            "status": "OK",
            "state": "submitted",
            "version": 0
